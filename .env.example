# =============================================
# CONFIGURACIÓN DEL SERVIDOR
# =============================================
PORT=3000

# =============================================
# BASE DE DATOS (PostgreSQL)
# =============================================
DATABASE_URL=postgresql://USUARIO:CONTRASEÑA@HOST:5432/NOMBRE_BD
PGHOST=HOST
PGDATABASE=NOMBRE_BD
PGUSER=USUARIO
PGPASSWORD=CONTRASEÑA

# =============================================
# JWT (JSON Web Token)
# Genera un secreto seguro con:
#   node -e "require('crypto').randomBytes(64).toString('hex')|> console.log"
# =============================================
JWT_SECRET=TU_SECRETO_SEGURO_DE_64_BYTES_EN_HEX
